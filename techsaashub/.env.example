# ─────────────────────────────────────────────
# TechSaaShub — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# ─────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Not currently used by the app — admin actions run under the signed-in
# user's session and rely on Row Level Security (see supabase/schema.sql)
# rather than a service-role bypass. Kept here for future server-only needs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=https://techsaashub.com
NEXT_PUBLIC_SITE_NAME=TechSaaShub

# Newsletter / Contact notifications (optional)
CONTACT_NOTIFICATION_EMAIL=hello@techsaashub.com
